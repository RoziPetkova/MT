@article{fagioli_intentional_2007,
	title = {Intentional control of attention: action planning primes action-related stimulus dimensions},
	volume = {71},
	rights = {http://www.springer.com/tdm},
	issn = {0340-0727, 1430-2772},
	url = {http://link.springer.com/10.1007/s00426-005-0033-3},
	doi = {10.1007/s00426-005-0033-3},
	shorttitle = {Intentional control of attention},
	pages = {22--29},
	number = {1},
	journaltitle = {Psychological Research},
	shortjournal = {Psychological Research},
	author = {Fagioli, Sabrina and Hommel, Bernhard and Schubotz, Ricarda Ines},
	urldate = {2026-02-10},
	date = {2007-01-11},
	langid = {english},
	keywords = {MT_soa-motor},
	annotation = {not read; used in discussion for {RT};What they tested
They investigated whether planning an action influences attention and perception, even before the action is actually executed. Specifically, participants prepared for either a reaching action or a grasping action. While they kept that action plan active (before doing it), they were presented with stimulus events that varied in perceptual features (like location or size). The question was:

Does preparing to move in a particular way make the brain process certain stimulus dimensions more effectively?


What they found


While participants were preparing a reaching action, they detected changes in location-based stimuli more quickly.


When preparing a grasping action, they detected changes in size-based stimuli more quickly.


This effect happened before actual movement execution, suggesting that merely planning the action biased perception toward action-related perceptual dimensions.



What it means (in simple terms)
Planning an action doesn’t just prepare the muscles — it also changes how your brain allocates attention to the world. If you plan to reach for something, you become better at noticing where things are. If you plan to grasp something, you become better at noticing what size things are. This suggests that action plans and attention/perception share processing resources.

Why it matters for your work
Although this study is not about sense of agency per se, it shows a key principle that is relevant for agency research:

Action preparation influences cognitive and perceptual processes even before action execution.

This supports the idea that in your experiment, active movement (even just planning it) can change how participants process subsequent stimuli and make judgments — including how they experience agency. This fits well with theoretical frameworks like the Theory of Event Coding ({TEC}) and intentional weighting mechanisms, which argue that action and perception are tightly coupled at early stages of processing.},
}

@article{brown_active_2011,
	title = {Active Inference, Attention, and Motor Preparation},
	volume = {2},
	issn = {1664-1078},
	url = {http://journal.frontiersin.org/article/10.3389/fpsyg.2011.00218/abstract},
	doi = {10.3389/fpsyg.2011.00218},
	journaltitle = {Frontiers in Psychology},
	shortjournal = {Front. Psychology},
	author = {Brown, Harriet and Friston, Karl and Bestmann, Sven},
	urldate = {2026-02-10},
	date = {2011},
	keywords = {MT_soa-motor},
	annotation = {not red; used in discussion of {RT}; What they tested:The study examined how motor preparation and attention are linked when planning and executing movements. They used adapted versions of a reaction-time paradigm (similar to a Posner cueing task) to see whether cues about a forthcoming movement could speed up reaction times and how attention in motor preparation interacts with prediction of sensory consequences of action. The framework they tested is based on active inference and predictive coding, which proposes that motor control and attention share mechanisms for predicting and preparing movements.
How it worked:Participants were given cues about:


what type of movement to prepare


which hand to {useThe} researchers then measured reaction times to these movements under different cueing conditions.


Main results ({RT} findings):


They found that valid cues about the movement and effector (hand) led to faster {RTs} than invalid cues.


There was a significant interaction between the type of cue and movement execution: valid preparation sped responses more than invalid preparation.


This suggests that attention and prediction in motor preparation improve {RTs}, similar to how visual attention speeds perception in classic Posner tasks.


Conceptual conclusion:These findings support the idea that motor planning and attention are deeply intertwined, and that preparing a movement (i.e., planning a voluntary action) is not just about issuing a command — it also mobilizes attentional systems that reduce reaction times for expected movements. This fits within predictive coding and active inference theories, where the brain continually predicts sensory and motor consequences to optimize performance.

In short (plain language)
This study shows that when people are told what movement to prepare, they react faster if the cues are correct. This means attention and motor planning work together to make actions quicker and more efficient, supporting theories that action preparation influences how fast we respond.

Why this is relevant for your experiment
Although this study does not directly measure sense of agency, it demonstrates that:✔ Motor preparation speeds reaction time✔ Attention is involved when planning voluntary movement✔ Valid motor predictions improve performance (faster {RT})
This complements your results showing that active conditions (with an action to execute) are behaviorally different (often faster {RTs}) compared to passive control conditions, because active trials engage motor prediction and attention mechanisms that reduce reaction times.
If you want, I can also find agency studies that explicitly link agency judgments with {RT} facilitation effects. Just let me know!},
	file = {Full Text:C\:\\Users\\Kaloyan Zdravkov\\Desktop\\Congitive Science\\MasterThesis\\GC + agency\\literature\\Agency and CG-0\\files\\518\\Brown et al. - 2011 - Active Inference, Attention, and Motor Preparation.pdf:application/pdf},
}

