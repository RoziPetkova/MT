        <dc:title>Freedom, choice, and the sense of agency</dc:title>
        <dc:date>2013</dc:date>
        <z:libraryCatalog>DOI.org (Crossref)</z:libraryCatalog>
        <dc:identifier>
            <dcterms:URI>
                <rdf:value>http://journal.frontiersin.org/article/10.3389/fnhum.2013.00514/abstract</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-02-11 17:20:20</dcterms:dateSubmitted>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:1662-5161">
        <prism:volume>7</prism:volume>
        <dc:title>Frontiers in Human Neuroscience</dc:title>
        <dc:identifier>DOI 10.3389/fnhum.2013.00514</dc:identifier>
        <dcterms:alternative>Front. Hum. Neurosci.</dcterms:alternative>
        <dc:identifier>ISSN 1662-5161</dc:identifier>
    </bib:Journal>
    <bib:Memo rdf:about="#item_527">
        <rdf:value>&lt;div data-schema-version=&quot;9&quot;&gt;&lt;p&gt;not red; used for free choice and agency in discussion&lt;br&gt;&lt;br&gt;&lt;strong&gt;Study context:&lt;/strong&gt;&lt;br&gt;Participants made actions with different numbers of possible choices (one, three, seven buttons) and measured intentional binding — a classic implicit index of sense of agency.&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;strong&gt;Quote:&lt;/strong&gt;&lt;br&gt;&lt;em&gt;“We found that the binding effect was strongest when participants had the maximum number of alternatives, intermediate when they had medium level of action choice and lowest when they had no choice.”&lt;/em&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;strong&gt;Quote (interpretation):&lt;/strong&gt;&lt;br&gt;&lt;em&gt;“Our results provide support for the notion that a high degree of choice is associated with greater action–effect binding than lower degrees of choice.”&lt;/em&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p&gt;&lt;strong&gt;Meaning:&lt;/strong&gt;&lt;br&gt;More choice (freedom to decide what action to make) increases implicit agency measures.&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
