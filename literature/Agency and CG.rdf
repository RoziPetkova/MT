        <dc:title>Having control over the external world increases the implicit sense of agency</dc:title>
        <dc:date>05/2017</dc:date>
        <z:language>en</z:language>
        <z:libraryCatalog>DOI.org (Crossref)</z:libraryCatalog>
        <dc:identifier>
            <dcterms:URI>
                <rdf:value>https://linkinghub.elsevier.com/retrieve/pii/S0010027717300343</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-02-11 17:20:40</dcterms:dateSubmitted>
        <bib:pages>54-60</bib:pages>
    </bib:Article>
    <bib:Memo rdf:about="#item_528">
        <rdf:value>&lt;div data-schema-version=&quot;9&quot;&gt;&lt;p&gt;not red; used for free choice and agency in discussion&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Study context:&lt;/strong&gt;&lt;br&gt;This paper compared conditions where action selection &lt;em&gt;meaningfully affected outcomes&lt;/em&gt; versus conditions where choice was irrelevant.&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;strong&gt;Quote:&lt;/strong&gt;&lt;br&gt;&lt;em&gt;“Our study shows that the ability to control outcomes by discriminative action selection is another key element of implicit sense of agency.”&lt;/em&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p&gt;&lt;strong&gt;Meaning:&lt;/strong&gt;&lt;br&gt;Choosing an action &lt;em&gt;that has meaningful control over outcomes&lt;/em&gt; strengthens implicit sense of agency.&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
