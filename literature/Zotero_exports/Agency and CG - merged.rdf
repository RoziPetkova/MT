    <bib:Article rdf:about="#item_jones_facial_2010_80">
        <z:itemType>journalArticle</z:itemType>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Jones</foaf:surname>
                        <foaf:givenname>Benedict C.</foaf:givenname>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>DeBruine</foaf:surname>
                        <foaf:givenname>Lisa M.</foaf:givenname>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Main</foaf:surname>
                        <foaf:givenname>Julie C.</foaf:givenname>
