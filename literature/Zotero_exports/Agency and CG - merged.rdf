    <bib:Article rdf:about="#item_simchon_computational_2023_144">
        <z:itemType>journalArticle</z:itemType>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Simchon</foaf:surname>
                        <foaf:givenname>Almog</foaf:givenname>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
