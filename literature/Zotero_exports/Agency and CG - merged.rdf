    <bib:Article rdf:about="#item_talipski_examining_2021_98">
        <z:itemType>journalArticle</z:itemType>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Talipski</foaf:surname>
